PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/entrenador-digital

# Clave para firmar los tokens. Genera una propia con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Orígenes permitidos para el frontend, separados por comas (vacío = todos)
CORS_ORIGIN=

# Solo para pruebas de la API: npm test usa esta base y la borra al terminar
# MONGO_URI_TEST=mongodb://127.0.0.1:27017/entrenador-test
